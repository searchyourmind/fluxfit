{
  "name": "DailyTarget",
  "type": "object",
  "properties": {
    "calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "calories",
    "protein_g",
    "carbs_g",
    "fat_g"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}