{
  "name": "WeightLog",
  "type": "object",
  "properties": {
    "weight_kg": {
      "type": "number"
    },
    "log_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "weight_kg",
    "log_date"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}