{
  "name": "WeeklyCheckin",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "avg_calories": {
      "type": "number"
    },
    "avg_protein": {
      "type": "number"
    },
    "weight_change_kg": {
      "type": "number"
    },
    "training_sessions": {
      "type": "number"
    },
    "adjustment_kcal": {
      "type": "number"
    },
    "recommendation": {
      "type": "string"
    }
  },
  "required": [
    "week_start"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}